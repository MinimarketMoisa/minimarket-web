# ─── Base de datos (la misma que FastAPI) ───────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/minimarket_db

# ─── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-cambia-esto-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── FastAPI (base URL para llamadas internas si se necesitan) ────────────────
FASTAPI_BASE_URL=http://localhost:8000
